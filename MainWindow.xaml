<Window x:Class="ElitLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elit Launcher" 
        Height="880" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextMain}"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Icon="logo.ico">

    <Window.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="WindowBg" Color="#000000"/>
            <SolidColorBrush x:Key="PanelBg" Color="#050505"/>
            <SolidColorBrush x:Key="CardBg" Color="#0D0D0D"/>
            <SolidColorBrush x:Key="CardHover" Color="#171717"/>
            <SolidColorBrush x:Key="AccentColor" Color="#E11D48"/>
            <SolidColorBrush x:Key="AccentHover" Color="#F43F5E"/>
            <SolidColorBrush x:Key="TextMain" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextMuted" Color="#737373"/>
            <SolidColorBrush x:Key="BorderSubtle" Color="#1F1F1F"/>
            <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>

            <Style x:Key="WindowControlButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="Width" Value="46"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#222222"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#E11D48"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
                <Setter Property="Background" Value="{DynamicResource CardBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColor}"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DarkComboBox" TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource CardBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" ClickMode="Press" Focusable="False" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6">
                                                <Grid Margin="10,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextMuted}" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" HorizontalAlignment="Left" IsHitTestVisible="False" Margin="12,0,30,0" VerticalAlignment="Center"/>
                                <Popup x:Name="Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Slide">
                                    <Grid x:Name="DropDown" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" SnapsToDevicePixels="True">
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0">
                                            <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernPrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource AccentHover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#333333"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernSecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource CardBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SecBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SecBorder" Property="Background" Value="{DynamicResource CardHover}"/>
                                    <Setter TargetName="SecBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="SecBorder" Property="Background" Value="#1A1A1A"/>
                                    <Setter Property="Foreground" Value="#555555"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernNavButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource CardBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- PASEK TYTUŁOWY -->
            <Grid Grid.Row="0" Background="{DynamicResource PanelBg}" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Image Source="logo.png" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Elit Launcher" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="─" Style="{StaticResource WindowControlButtonStyle}" Click="BtnMinimize_Click"/>
                    <Button Content="☐" Style="{StaticResource WindowControlButtonStyle}" Click="BtnMaximize_Click"/>
                    <Button Content="✕" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- GŁÓWNY INTERFEJS -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- PASEK BOCZNY -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,1,0">
                    <Grid Margin="20">
                        <StackPanel VerticalAlignment="Top">
                            <StackPanel Margin="0,10,0,32">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border CornerRadius="8" ClipToBounds="True" Margin="0,0,12,0">
                                        <Image Source="logo.png" Width="44" Height="44" VerticalAlignment="Center" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="ELIT" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Text="LAUNCHER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,-2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <Button Content="⚡  Pulpit Główny" Style="{StaticResource ModernNavButton}" Click="NavPulpit_Click" Margin="0,0,0,6"/>
                            <Button Content="🧩  Zarządzanie DLL" Style="{StaticResource ModernNavButton}" Click="NavDll_Click" Margin="0,0,0,6"/>
                            <Button Content="📊  Logi Systemowe" Style="{StaticResource ModernNavButton}" Click="NavLogi_Click" Margin="0,0,0,24"/>

                            <TextBlock Text="Wybór motywu wyglądu:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                            <ComboBox x:Name="CbThemes" Style="{StaticResource DarkComboBox}" Height="38" SelectionChanged="CbThemes_SelectionChanged">
                                <ComboBoxItem Content="Crimson Black" IsSelected="True"/>
                                <ComboBoxItem Content="Cyber Violet"/>
                                <ComboBoxItem Content="Emerald Dark"/>
                                <ComboBoxItem Content="Midnight Blue"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- STRONY -->
                <Grid Grid.Column="1" Margin="40">
                    <!-- ZAKŁADKA 1: PULPIT -->
                    <StackPanel x:Name="TabPulpit" Visibility="Visible">
                        <TextBlock Text="Zarządzanie Modyfikacjami" FontSize="24" FontWeight="Black" Foreground="{DynamicResource TextMain}" Margin="0,0,0,24"/>

                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="28" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Rodzaj Modyfikacji / Wariantu:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnSelectTOU" Grid.Column="0" Content="Zwykłe TOU" Style="{StaticResource ModernPrimaryButton}" Height="38" Click="BtnSelectTOU_Click"/>
                                    <Button x:Name="BtnSelectMira" Grid.Column="2" Content="TOU-Mira" Style="{StaticResource ModernSecondaryButton}" Height="38" Click="BtnSelectMira_Click"/>
                                    <Button x:Name="BtnSelectVanilla" Grid.Column="4" Content="Vanilla (Czysta)" Style="{StaticResource ModernSecondaryButton}" Height="38" Click="BtnSelectVanilla_Click"/>
                                </Grid>

                                <!-- SEKCJA MODOWANA -->
                                <StackPanel x:Name="PanelModControls" Visibility="Visible">
                                    <TextBlock Text="Wersja Modyfikacji (GitHub Releases):" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>
                                    <ComboBox x:Name="CbVersions" Style="{StaticResource DarkComboBox}" Height="38" Margin="0,0,0,12" SelectionChanged="CbVersions_SelectionChanged"/>

                                    <Border Background="#14ffffff" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Stan instalacji: " FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock x:Name="TxtModStatus" Text="Sprawdzanie..." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                        </StackPanel>
                                    </Border>

                                    <Button x:Name="BtnDownload" Content="Pobierz i Zainstaluj Wybraną Modyfikację" Style="{StaticResource ModernPrimaryButton}" Height="44" Click="BtnDownload_Click" Margin="0,0,0,12"/>

                                    <ProgressBar x:Name="ProgressBarDownload" Height="4" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource AccentColor}" BorderThickness="0" Margin="0,0,0,8" Value="0" Maximum="100"/>
                                    <TextBlock x:Name="TxtDownloadStatus" Text="Oczekiwanie..." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,16"/>
                                </StackPanel>

                                <!-- SEKCJA INFORMACJI W VANILLA -->
                                <StackPanel x:Name="PanelVanillaInfo" Visibility="Collapsed" Margin="0,0,0,20">
                                    <Border Background="#10ffffff" CornerRadius="6" Padding="16">
                                        <TextBlock Text="Tryb czystej gry Vanilla. Gra uruchomi się bezpośrednio z folderu głownego bez użycia jakichkolwiek modyfikacji." FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>

                                <!-- PRZYCISK URUCHAMIANIA -->
                                <Button x:Name="BtnMainLaunch" Content="🚀 Uruchom Zmodowaną Grę" Style="{StaticResource ModernPrimaryButton}" Height="52" FontSize="15" Click="BtnMainLaunch_Click"/>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="PanelBottomTools">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="🛠️ Napraw Modyfikację" Style="{StaticResource ModernSecondaryButton}" Height="44" Click="BtnRepairMods_Click"/>
                            <Button Grid.Column="2" Content="📁 Otwórz Folder" Style="{StaticResource ModernSecondaryButton}" Height="44" Click="BtnOpenModFolder_Click"/>
                            <Button Grid.Column="4" Content="🗑️ Usuń Moda" Style="{StaticResource ModernSecondaryButton}" Height="44" Click="BtnDeleteMod_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- ZAKŁADKA 2: ZARZĄDZANIE DLL -->
                    <StackPanel x:Name="TabDll" Visibility="Collapsed">
                        <TextBlock Text="Zarządzanie Wtyczkami (.DLL)" FontSize="24" FontWeight="Black" Foreground="{DynamicResource TextMain}" Margin="0,0,0,24"/>

                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="28" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Menedżer Modułów i Wtyczek DLL:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,16"/>

                                <!-- AUnlocker -->
                                <Border Background="#09ffffff" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="AUnlocker.dll" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="TxtStatusAUnlocker" Text="Sprawdzanie..." FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Odblokowywanie kosmetyków oraz skórek w grze." FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="BtnInstallAUnlocker" Content="Pobierz" Style="{StaticResource ModernSecondaryButton}" Padding="12,6" Margin="0,0,6,0" Click="BtnInstallAUnlocker_Click"/>
                                            <Button x:Name="BtnToggleAUnlocker" Content="Wyłącz" Style="{StaticResource ModernSecondaryButton}" Padding="12,6" Margin="0,0,6,0" Click="BtnToggleAUnlocker_Click"/>
                                            <Button x:Name="BtnDeleteAUnlocker" Content="Usuń" Style="{StaticResource ModernSecondaryButton}" Padding="12,6" Click="BtnDeleteAUnlocker_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- MiraStatsExporter -->
                                <Border Background="#09ffffff" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="MiraStatsExporter.dll" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="TxtStatusMiraStats" Text="Sprawdzanie..." FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Zaawansowany moduł analityki i statystyk gier." FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="BtnInstallMiraStats" Content="Pobierz" Style="{StaticResource ModernSecondaryButton}" Padding="12,6" Margin="0,0,6,0" Click="BtnInstallMiraStats_Click"/>
                                            <Button x:Name="BtnToggleMiraStats" Content="Wyłącz" Style="{StaticResource ModernSecondaryButton}" Padding="12,6" Margin="0,0,6,0" Click="BtnToggleMiraStats_Click"/>
                                            <Button x:Name="BtnDeleteMiraStats" Content="Usuń" Style="{StaticResource ModernSecondaryButton}" Padding="12,6" Click="BtnDeleteMiraStats_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- AleLuduMod -->
                                <Border Background="#09ffffff" CornerRadius="6" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="AleLuduMod.dll" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="TxtStatusAleLudu" Text="Sprawdzanie..." FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Dedykowane rozszerzenie społecznościowe i mechaniki." FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="BtnInstallAleLudu" Content="Pobierz" Style="{StaticResource ModernSecondaryButton}" Padding="12,6" Margin="0,0,6,0" Click="BtnInstallAleLudu_Click"/>
                                            <Button x:Name="BtnToggleAleLudu" Content="Wyłącz" Style="{StaticResource ModernSecondaryButton}" Padding="12,6" Margin="0,0,6,0" Click="BtnToggleAleLudu_Click"/>
                                            <Button x:Name="BtnDeleteAleLudu" Content="Usuń" Style="{StaticResource ModernSecondaryButton}" Padding="12,6" Click="BtnDeleteAleLudu_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Zbiorcza Naprawa i Pobieranie DLL" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                    <TextBlock Text="Automatycznie pobiera i nadpisuje wszystkie wtyczki w katalogu gry." FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="🔧 Napraw Wszystkie Wtyczki" Style="{StaticResource ModernPrimaryButton}" Padding="20,10" Click="BtnRepairAllDll_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ZAKŁADKA 3: LOGI -->
                    <StackPanel x:Name="TabLogi" Visibility="Collapsed">
                        <TextBlock Text="Logi Systemowe" FontSize="24" FontWeight="Black" Foreground="{DynamicResource TextMain}" Margin="0,0,0,24"/>
                        <TextBox x:Name="TxtConsole" Height="500" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="{DynamicResource CardBg}" Foreground="{DynamicResource AccentColor}" BorderBrush="{DynamicResource BorderSubtle}" Padding="16" FontFamily="Consolas" FontSize="12"/>
                        <Button Content="Wyczyść logi" Style="{StaticResource ModernSecondaryButton}" Width="160" Height="40" Margin="0,16,0,0" HorizontalAlignment="Left" Click="BtnClearLogs_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>